# ==============================================================================
# Enterprise Agentic RAG Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file or real API keys to version control!
# ==============================================================================

# --- Groq Reasoning Engine & Guardrails ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GUARDRAIL_MODEL=openai/gpt-oss-20b
GUARD_MODE=single_call
GROQ_SLUG=rag
GROQ_SLUG_2=brag

# --- Portkey LLM Gateway ---
PORTKEY_API_KEY=your_portkey_api_key_here
PORTKEY_CONFIG_ID=

# --- Qdrant Vector Database ---
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.us-east-2-0.aws.cloud.qdrant.io

# --- Gemini Embeddings (Optional: if empty, defaults to local sentence-transformers all-mpnet-base-v2) ---
GEMINI_API_KEY=

# --- Observability: Pydantic Logfire ---
LOGFIRE_TOKEN=your_logfire_token_here

# --- Observability: LangSmith Tracing ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=enterprise-agentic-rag

# --- Backend Service URL ---
BACKEND_URL=http://localhost:8000

# --- Evaluation Suite (RAGAS Judge) ---
JUDGE_GROQ=your_judge_groq_api_key_here

# --- Persistence & Memory Checkpointer ---
# By default, uses SQLite for local single-worker development
SQLITE_DB_PATH=checkpoints.db
# Optional: Set DATABASE_URL (postgresql://user:password@host:port/dbname) for multi-worker production
DATABASE_URL=

# --- Gateway Resilience (Tenacity) ---
LLM_MAX_RETRIES=3
LLM_RETRY_MIN_WAIT=2.0
LLM_RETRY_MAX_WAIT=10.0

